<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" shutdownHook="disable">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n" />
        </Console>

        <!-- Rolling file: avoids unbounded application.log growth on long runs -->
        <RollingFile name="msglog"
                     fileName="application.log"
                     filePattern="application-%i.log.gz"
                     append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n" />
            <Policies>
                <SizeBasedTriggeringPolicy size="50MB" />
            </Policies>
            <DefaultRolloverStrategy max="3" />
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger level="warn" name="io.netty"/>
        <Logger level="warn" name="pt.unl.fct.di.novasys.network"/>
        <Logger level="warn" name="pt.unl.fct.di.novasys.channel"/>
        <Logger level="warn" name="pt.unl.fct.di.novasys.babel"/>

        <Logger name="protocols." level="warn" additivity="false">
            <AppenderRef ref="Console" level="info"/>
            <AppenderRef ref="msglog" level="warn"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
